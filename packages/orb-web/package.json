{
  "name": "@orbic/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WebGL2 renderer for Orbic \u2014 animated Orb and static Surface components.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@orbic/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^5.7.3",
    "esbuild": "^0.28.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./minimal": {
      "types": "./dist/minimal.d.ts",
      "default": "./dist/minimal.js"
    },
    "./fields/*": {
      "types": "./dist/generated/fields/*.d.ts",
      "default": "./dist/generated/fields/*.js"
    }
  }
}
