{
  "name": "orbic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "lint": "eslint .",
    "generate:fixtures": "tsx packages/orb-core/scripts/generate-fixtures.ts",
    "build:presets": "node scripts/build-presets.mjs",
    "build:shaders": "node scripts/build-shaders.mjs",
    "build:metallibs": "node scripts/build-metallibs.mjs",
    "check-shaders": "node scripts/check-shaders.mjs",
    "orbic": "node packages/orb-core/bin/orbic.mjs",
    "dev:web": "pnpm --filter @orbic/example-web run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "canvaskit-wasm": "^0.42.0",
    "eslint": "^9.19.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
