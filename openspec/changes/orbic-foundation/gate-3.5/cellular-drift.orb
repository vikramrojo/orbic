// GATE EXERCISE ONLY — NOT A SHIPPED FIELD.
//
// Task 3.5 requires sanity-checking the four-channel ABI against a field from
// outside the shipped set. All six fields analysed in tasks 3.1-3.4 came from
// pbakaus/radiant and therefore share uniform conventions, so they never
// exercised the contract independently: they agree with each other because
// they have a common ancestor, not because the contract is general.
//
// This field is deliberately from a different lineage — the Shadertoy /
// Inigo Quilez procedural tradition of cellular (Worley/Voronoi) noise, whose
// conventions were developed with no knowledge of radiant's uniform set. It
// is authored here rather than ported verbatim so it can be published in this
// repository, but its parameterisation follows that tradition's norms:
// cell density, jitter, edge sharpness, and drift — NOT a speed/magnitude
// pair.
//
// The point of the exercise is that this field wants THREE structural axes,
// where every radiant field wanted one. See gate-3.5/findings.md.

float cellHash(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec2 cellPoint(vec2 cell, float jitter, float clock) {
    // Each cell's feature point drifts on its own small orbit, so the pattern
    // moves without the whole lattice sliding.
    float a = cellHash(cell) * 6.2831853;
    float b = cellHash(cell + 17.0) * 6.2831853;
    vec2 offset = vec2(sin(a + clock * 0.6), cos(b + clock * 0.6));
    return cell + 0.5 + offset * 0.5 * jitter;
}

/// Returns x = distance to the nearest feature point, y = distance to the
/// second nearest. F2 - F1 is the classic cell-edge measure.
vec2 cellular(vec2 p, float jitter, float clock) {
    vec2 base = floor(p);
    float f1 = 8.0;
    float f2 = 8.0;

    // Constant bounds: the portable subset forbids unbounded and while loops.
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            vec2 cell = base + vec2(float(i), float(j));
            float d = length(cellPoint(cell, jitter, clock) - p);
            if (d < f1) {
                f2 = f1;
                f1 = d;
            } else if (d < f2) {
                f2 = d;
            }
        }
    }

    return vec2(f1, f2);
}

vec3 field(vec2 p, float t, float energy, float coherence, float warmth, float pulse) {
    // `t` is already scaled by pulse and speed (docs/shader-abi.md).
    float clock = t;

    // THE MAPPING STRAIN, made explicit. This field has three independent
    // structural controls in its own tradition — density, jitter, and edge
    // sharpness — and the ABI offers exactly one structural channel. All
    // three are therefore driven from `coherence` along a hand-chosen curve.
    // That is a real authoring decision, not a remapping: it fixes the
    // correlation between them, so the "sparse but ragged" and "dense but
    // crisp" corners of this field's own parameter space are unreachable
    // through the ABI.
    float density = mix(3.0, 9.0, coherence);
    float jitter = mix(1.0, 0.35, coherence);
    float sharpness = mix(1.5, 7.0, coherence);

    vec2 f = cellular(p * density, jitter, clock);

    // F2 - F1 approaches zero at cell borders, so this reads as a web of
    // bright edges.
    float edge = 1.0 - clamp((f.y - f.x) * sharpness, 0.0, 1.0);
    edge = pow(max(edge, 0.0), 1.6);

    // Cell interiors get a slow luminance wander so the field breathes.
    float interior = 0.5 + 0.5 * sin(cellHash(floor(p * density)) * 6.2831853 + clock * 0.4);

    // Warmth is authored, not remapped: like every radiant field, this
    // tradition hardcodes its palette as literal constants, so there is no
    // source parameter to map onto. Confirms the tasks 3.1-3.4 finding from
    // an unrelated direction.
    vec3 cool = vec3(0.22, 0.42, 0.72);
    vec3 warm = vec3(0.85, 0.47, 0.24);
    vec3 tint = mix(cool, warm, warmth);

    float amplitude = mix(0.25, 1.0, energy);

    vec3 col = tint * (edge * 0.85 + interior * 0.18) * amplitude;

    // Grain, matching the shipped fields' convention.
    float grain = cellHash(p * 700.0 + clock * 11.0);
    col += (grain - 0.5) * 0.01;

    return clamp(col, 0.0, 1.0);
}
